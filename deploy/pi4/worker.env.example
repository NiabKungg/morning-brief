# /home/pi4/mib/worker.env (chmod 600). deploy.sh creates it on first deploy.
# The hub by the Pi 5's mDNS name (<hostname>.local), not its IP, so a new DHCP address after a network change is fine.
MIB_HUB_WS=ws://raspberrypi.local:8800/ws/worker
MIB_TOKEN=change-me-shared-with-the-worker
MIB_WORKER_ID=pi4
MIB_DATA_DIR=/home/pi4/mib/data
MIB_CHROMIUM=/usr/bin/chromium
MIB_HTTP_CONCURRENCY=6
