[Unit]
Description=MIB brain: llama-server with LiquidAI LFM3-1.7B (QAD Q4_0)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi5
WorkingDirectory=/home/pi5/mib
# Measured on the Pi 5 with llama-bench and replayed MIB prompts (README "Model choice"):
# -t 3 decodes fastest (11.9 tok/s vs 11.1 with 4); -tb 4 prefills fastest.
# --flash-attn off: the CPU flash-attention kernel loses decode speed as the context grows (8.4 vs 10.8 tok/s at
#   3k tokens, the size of the brief prompt); -ub 256 wins back the ~3% prefill that costs.
# --cache-ram 1024: the default 8 GiB prompt cache grew the server past 3 GB; these prompts rarely share prefixes.
ExecStart=/home/pi5/mib/src/llama.cpp/build/bin/llama-server \
    --model /home/pi5/mib/models/LFM3-1.7B-QAD-Q4_0.gguf \
    --alias LFM3-1.7B-QAD-Q4_0 \
    --host 127.0.0.1 --port 8081 \
    --ctx-size 16384 --parallel 1 \
    --threads 3 --threads-batch 4 \
    --flash-attn off --ubatch-size 256 \
    --cache-ram 1024 \
    --jinja --metrics --no-webui
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
